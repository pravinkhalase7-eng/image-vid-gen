# StoryMotion AI — VPS / Jenkins deploy env
# Create Jenkins credential:
#   Kind: Secret file
#   ID:   storymotion-env-file
#   File: copy of this (filled in)

# --- Compose / host ports ---
APP_HOST_PORT=4000

# --- App ---
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_TEXT_MODEL=gemini-3.6-flash
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

ENABLE_VIDEO_GENERATION=false
MOCK_VIDEO_GENERATION=false
JOB_RUNNER=inline
ENABLE_CHARACTER_REFERENCES=false
ENABLE_NATIVE_VIDEO_AUDIO=true

DATABASE_URL=file:/data/prod.db
STORAGE_DRIVER=local
STORAGE_PATH=/app/storage

# Browser-facing URL — must be the real VPS IP/domain, NOT a placeholder
NEXT_PUBLIC_APP_NAME="StoryMotion AI"
NEXT_PUBLIC_APP_URL=http://187.127.138.86:4000
