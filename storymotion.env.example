# StoryMotion AI — VPS / Jenkins deploy env
# Create Jenkins credential:
#   Kind: Secret file
#   ID:   storymotion-env-file   ← ID field in Jenkins, NOT the filename
#   File: this file with GOOGLE_AI_API_KEY filled in
# Then rebuild the pipeline. Uploading the credential does nothing until the next deploy.

# --- Compose / host ports ---
APP_HOST_PORT=4000

# --- App ---
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=
GOOGLE_TEXT_MODEL=gemini-3.6-flash
GOOGLE_VIDEO_MODEL=veo-3.1-fast-generate-preview
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview
GOOGLE_IMAGE_MODEL=imagen-4.0-generate-001

ENABLE_VIDEO_GENERATION=false
MOCK_VIDEO_GENERATION=false
JOB_RUNNER=inline
ENABLE_CHARACTER_REFERENCES=false
ENABLE_NATIVE_VIDEO_AUDIO=true

# Optional ElevenLabs voice (used when set; otherwise Gemini TTS)
# Do NOT put this value in GOOGLE_AI_API_KEY — Gemini will reject it.
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_CHILD=
# ELEVENLABS_VOICE_FEMALE=
# ELEVENLABS_VOICE_MALE=

DATABASE_URL=file:/data/prod.db
STORAGE_DRIVER=local
STORAGE_PATH=/app/storage

# Browser-facing URL — must be the real VPS IP/domain, NOT a placeholder
NEXT_PUBLIC_APP_NAME="StoryMotion AI"
NEXT_PUBLIC_APP_URL=http://187.127.138.86:4000
