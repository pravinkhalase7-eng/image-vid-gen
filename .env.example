# Database
DATABASE_URL="file:./prisma/dev.db"

# Google AI (never expose these to the browser)
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# Models — keep configurable; do not hard-code obsolete IDs
GOOGLE_TEXT_MODEL="gemini-3.6-flash"
GOOGLE_VIDEO_MODEL="veo-3.1-fast-generate-preview"
GOOGLE_TTS_MODEL="gemini-3.1-flash-tts-preview"
GOOGLE_IMAGE_MODEL="imagen-4.0-generate-001"

# Feature flags
MOCK_VIDEO_GENERATION="true"
ENABLE_VIDEO_GENERATION="false"
JOB_RUNNER="inline"
ENABLE_CHARACTER_REFERENCES="false"
ENABLE_NATIVE_VIDEO_AUDIO="true"

# Storage
STORAGE_DRIVER="local"
STORAGE_PATH="./storage"
# GCS_BUCKET=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# App
NEXT_PUBLIC_APP_NAME="StoryMotion AI"
NEXT_PUBLIC_APP_URL="http://localhost:4000"

# Optional ElevenLabs voice. Do not paste this into GOOGLE_AI_API_KEY.
# ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL="eleven_multilingual_v2"
# ELEVENLABS_VOICE_ID=
